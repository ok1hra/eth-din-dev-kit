    id: total_power
    min_value: 0.0
    max_value: 1.0
    step: 0.01
    mode: slider
    optimistic: true
    initial_value: 0.0
    icon: "mdi:lightning-bolt"
    web_server:
      sorting_group_id: group_status
      sorting_weight: 4
    on_value:
      - lambda: |-
          float per_phase = 1.0f / 3.0f;
          float v = x;
          float ssr_lvl = 0.0f;
          if (v < per_phase) {
            ssr_lvl = v / per_phase;
            id(stykac1).turn_off();
            id(stykac2).turn_off();
          } else if (v < 2.0f * per_phase) {
            ssr_lvl = (v - per_phase) / per_phase;
            id(stykac1).turn_on();
            id(stykac2).turn_off();
          } else {
            ssr_lvl = (v - 2.0f * per_phase) / per_phase;
            id(stykac1).turn_on();
            id(stykac2).turn_on();
          }
          id(ssr).set_level(ssr_lvl);

# ────────────── SENSORS ──────────────
sensor:
  # ── Dallas teplota vody ──
  - platform: dallas_temp
    index: 0
    name: "Teplota vody"   # první čidlo na one_wire sběrnici
    id: temp
    update_interval: 5s
    web_server:
      sorting_group_id: group_status
      sorting_weight: 1

  # ── Modbus: System (Unit ID 100) ──
  - platform: modbustcp_controller
    modbustcp_controller_id: cerbo_system
    name: "SOC baterie"
    id: soc_sensor
    register_type: holding
    address: 843
    value_type: U_WORD
    unit_of_measurement: "%"
    accuracy_decimals: 0
    device_class: battery
    state_class: measurement
    icon: "mdi:battery"
    web_server:
      sorting_group_id: group_status
      sorting_weight: 3

  # ── Modbus: Grid meter (Unit ID 31) ──
  # Registry 2600-2602: výkony L1/L2/L3 (W), int16, scale 1:1
  # Kladné = import ze sítě, záporné = export do sítě
  - platform: modbustcp_controller
    modbustcp_controller_id: cerbo_grid
    name: "Grid výkon L1"
    id: grid_l1_sensor
    register_type: holding
    address: 2600
    value_type: S_WORD
    unit_of_measurement: "W"
    accuracy_decimals: 0
    device_class: power
    state_class: measurement
    icon: "mdi:transmission-tower"

  - platform: modbustcp_controller
    modbustcp_controller_id: cerbo_grid
    name: "Grid výkon L2"
    id: grid_l2_sensor
    register_type: holding
    address: 2601
    value_type: S_WORD
    unit_of_measurement: "W"
    accuracy_decimals: 0
    device_class: power
    state_class: measurement
    icon: "mdi:transmission-tower"

  - platform: modbustcp_controller
    modbustcp_controller_id: cerbo_grid
    name: "Grid výkon L3"
    id: grid_l3_sensor
    register_type: holding
    address: 2602
    value_type: S_WORD
    unit_of_measurement: "W"
    accuracy_decimals: 0
    device_class: power
    state_class: measurement
    icon: "mdi:transmission-tower"

  # Celkový výkon sítě = součet L1+L2+L3 (register 2603 nespolehlivý)
  - platform: template
    name: "Výkon sítě celkem (W)"
    id: grid_power_sensor
    unit_of_measurement: "W"
    accuracy_decimals: 0
    device_class: power
    state_class: measurement
    update_interval: 2s
    lambda: |-
      return id(grid_l1_sensor).state
           + id(grid_l2_sensor).state
           + id(grid_l3_sensor).state;
    icon: "mdi:transmission-tower"
    web_server:
      sorting_group_id: group_status
      sorting_weight: 2

  # ── Template sensory ──
  - platform: template
    name: "PI integrál"
    id: pi_integral_sensor
    unit_of_measurement: ""
    accuracy_decimals: 3
    update_interval: 2s
    lambda: |-
      return id(pi_integral);
    icon: "mdi:sigma"
    web_server:
      sorting_group_id: group_status
      sorting_weight: 5

  - platform: template
    name: "Termostat výkon (%)"
    id: thermostat_pct
    unit_of_measurement: "%"
    accuracy_decimals: 1
    update_interval: 2s
    lambda: |-
      return id(thermostat_output) * 100.0f;
    icon: "mdi:thermometer-auto"
    web_server:
      sorting_group_id: group_status
      sorting_weight: 6

  - platform: template
    name: "SSR úroveň"
    unit_of_measurement: ""
    update_interval: 1s
    lambda: |-
      return id(total_power).state;
    icon: "mdi:sine-wave"
    web_server:
      sorting_group_id: group_status
      sorting_weight: 7

# ────────────── BINARY SENSORS ──────────────
binary_sensor:
  - platform: template
    name: "Cerbo GX online"
    id: cerbo_online_sensor
    device_class: connectivity
    lambda: |-
      return id(cerbo_online);
    icon: "mdi:lan-connect"
    web_server:
      sorting_group_id: group_status
      sorting_weight: 8

  - platform: template
    name: "Termostat aktivní"
    lambda: |-
      return id(thermostat_output) > 0.01f;
    icon: "mdi:clock-time-four"
    web_server:
      sorting_group_id: group_status
      sorting_weight: 9

  - platform: template
    name: "Wattrouter aktivní"
    lambda: |-
      return id(wattrouter_output) > 0.01f;
    icon: "mdi:solar-power"
    web_server:
      sorting_group_id: group_status
      sorting_weight: 10

# ────────────── SWITCHES ──────────────
switch:
