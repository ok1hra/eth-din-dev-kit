    name: "Wattrouter zapnout"
    id: wattrouter_enable
    optimistic: true
    restore_mode: RESTORE_DEFAULT_OFF
    icon: "mdi:solar-power"
    turn_off_action:
      - globals.set:
          id: wattrouter_output
          value: '0.0'
      - globals.set:
          id: pi_integral
          value: '0.0'
    web_server:
      sorting_group_id: group_wattrouter
      sorting_weight: 0

  - platform: template
    name: "Termostat zapnout"
    id: thermostat_enable
    optimistic: true
    restore_mode: RESTORE_DEFAULT_OFF
    icon: "mdi:thermometer-auto"
    turn_off_action:
      - globals.set:
          id: thermostat_output
          value: '0.0'
    web_server:
      sorting_group_id: group_thermostat
      sorting_weight: 1

  - platform: template
    name: "Okno 1 - pracovní dny"
    id: w1_workdays
    optimistic: true
    restore_mode: RESTORE_DEFAULT_ON
    icon: "mdi:briefcase"
    web_server:
      sorting_group_id: group_window1
      sorting_weight: 0

  - platform: template
    name: "Okno 1 - víkend"
    id: w1_weekend
    optimistic: true
    restore_mode: RESTORE_DEFAULT_OFF
    icon: "mdi:sofa"
    web_server:
      sorting_group_id: group_window1
      sorting_weight: 1

  - platform: template
    name: "Okno 2 - pracovní dny"
    id: w2_workdays
    optimistic: true
    restore_mode: RESTORE_DEFAULT_ON
    icon: "mdi:briefcase"
    web_server:
      sorting_group_id: group_window2
      sorting_weight: 0

  - platform: template
    name: "Okno 2 - víkend"
    id: w2_weekend
    optimistic: true
    restore_mode: RESTORE_DEFAULT_OFF
    icon: "mdi:sofa"
    web_server:
      sorting_group_id: group_window2
      sorting_weight: 1

  - platform: template
    name: "Okno 3 - pracovní dny"
    id: w3_workdays
    optimistic: true
    restore_mode: RESTORE_DEFAULT_ON
    icon: "mdi:briefcase"
    web_server:
      sorting_group_id: group_window3
      sorting_weight: 0

  - platform: template
    name: "Okno 3 - víkend"
    id: w3_weekend
    optimistic: true
    restore_mode: RESTORE_DEFAULT_OFF
    icon: "mdi:sofa"
    web_server:
      sorting_group_id: group_window3
      sorting_weight: 1

  - platform: template
    name: "Stykač L2"
    optimistic: true
    lambda: return id(stykac1).state;
    icon: "mdi:power-plug"
    web_server:
      sorting_group_id: group_status
      sorting_weight: 11

  - platform: template
    name: "Stykač L3"
    optimistic: true
    lambda: return id(stykac2).state;
    icon: "mdi:power-plug"
    web_server:
      sorting_group_id: group_status
      sorting_weight: 12

  - platform: gpio
    pin: GPIO13
    name: "Contactor L2"
    id: stykac1
    internal: true

  - platform: gpio
    pin: GPIO14
    name: "Contactor L3"
    id: stykac2
    internal: true

# ────────────── TIME ──────────────
time:
  - platform: sntp
    id: sntp_time
    timezone: "Europe/Prague"

# ────────────── OUTPUT ──────────────
output:
  - platform: slow_pwm
    pin: GPIO12
    id: ssr
    period: 100ms
    zero_means_zero: true
    inverted: false

# ────────────── MAIN CONTROL LOOP ──────────────
interval:
  - interval: 2s
    then:
      - lambda: |-
          const float dt = 2.0f;

          // ── Thermostat: P-controller s pásmem regulace ────────────────
          auto in_window = [](int h, int m, int sh, int sm, int eh, int em) -> bool {
            int now_min   = h * 60 + m;
            int start_min = sh * 60 + sm;
            int end_min   = eh * 60 + em;
            return (now_min >= start_min && now_min < end_min);
          };

          auto now = id(sntp_time).now();
          float therm_out = 0.0f;

          if (now.is_valid() && id(thermostat_enable).state) {
            int cur_h  = now.hour;
            int cur_m  = now.minute;
            bool is_weekend = (now.day_of_week == 1 || now.day_of_week == 7);
            bool is_workday = !is_weekend;
            float water_temp = id(temp).state;
            float band = id(thermostat_band).state;

            float active_target = -1.0f;

            bool w1_ok = (is_workday && id(w1_workdays).state)
                      || (is_weekend && id(w1_weekend).state);
            if (w1_ok && in_window(cur_h, cur_m,
                   (int)id(w1_start_h).state, (int)id(w1_start_m).state,
                   (int)id(w1_end_h).state,   (int)id(w1_end_m).state))
              active_target = id(w1_temp).state;

            bool w2_ok = (is_workday && id(w2_workdays).state)
                      || (is_weekend && id(w2_weekend).state);
            if (w2_ok && in_window(cur_h, cur_m,
                   (int)id(w2_start_h).state, (int)id(w2_start_m).state,
                   (int)id(w2_end_h).state,   (int)id(w2_end_m).state))
              active_target = id(w2_temp).state;

            bool w3_ok = (is_workday && id(w3_workdays).state)
                      || (is_weekend && id(w3_weekend).state);
            if (w3_ok && in_window(cur_h, cur_m,
                   (int)id(w3_start_h).state, (int)id(w3_start_m).state,
                   (int)id(w3_end_h).state,   (int)id(w3_end_m).state))
              active_target = id(w3_temp).state;

            if (active_target > 0.0f) {
              float error = active_target - water_temp;
              therm_out = std::max(0.0f, std::min(1.0f, error / band));
            }
          }
          id(thermostat_output) = therm_out;

          // ── Wattrouter: PI-controller s anti-windup ───────────────────
          // grid_power_sensor.state: kladné = import, záporné = export
          if (id(wattrouter_enable).state && id(cerbo_online)) {
            float grid_w   = id(grid_power_sensor).state;
            float target_w = id(wattrouter_target).state;
            float kp       = id(wattrouter_p_gain).state;
            float ki       = id(wattrouter_i_gain).state / 1000000.0f;
