# SOLARBEAM EMS NG - verze 10
# Změny: MQTT nahrazeno Modbus TCP (creepystefan/esphome_modbus_tcp)
#        Grid data (L1/L2/L3) + SOC čteny přímo z Cerbo GX přes Modbus TCP
#        Unit ID 100 = com.victronenergy.system (SOC, reg 843)
#        Unit ID  31 = com.victronenergy.grid   (grid meter, reg 2600+)

esphome:
  name: esphome-web-ab7e4c
  friendly_name: SOLARBEAM EMS NG - 1
  min_version: 2025.5.0
  name_add_mac_suffix: false
  on_boot:
    priority: -10
    then:
      - output.turn_on: ssr
      - output.set_level:
          id: ssr
          level: 0.0
      - switch.turn_off: wattrouter_enable
      - switch.turn_off: thermostat_enable

esp32:
  board: esp32dev
  framework:
    type: esp-idf

logger:
  level: INFO

api:

ota:
  - platform: esphome

web_server:
  port: 80
  version: 3
  sorting_groups:
    - id: group_status
      name: "📊 Status"
      sorting_weight: 1
    - id: group_wattrouter
      name: "⚡ Wattrouter"
      sorting_weight: 2
    - id: group_thermostat
      name: "🌡️ Termostat"
      sorting_weight: 3
    - id: group_window1
      name: "🕐 Časové okno 1"
      sorting_weight: 4
    - id: group_window2
      name: "🕑 Časové okno 2"
      sorting_weight: 5
    - id: group_window3
      name: "🕒 Časové okno 3"
      sorting_weight: 6

wifi:
  ssid: "Internet"
  password: "lopata#*"
  ap:
    ssid: "EMS NG"
    password: "12345678"

# ─── Modbus TCP — external component ─────────────────────────────
external_components:
  - source: github://creepystefan/esphome_modbus_tcp
    refresh: 0s

modbustcp:
  - id: cerbo_tcp
    host: "192.168.27.37"
    port: 502
    send_wait_time: 250ms

modbustcp_controller:
  # System data (SOC atd.) — Unit ID 100
  - id: cerbo_system
    modbustcp_id: cerbo_tcp
    address: 100
    update_interval: 10s
    on_online:
      then:
        - globals.set:
            id: cerbo_online
            value: 'true'
        - logger.log: "Cerbo GX Modbus: online"
    on_offline:
      then:
        - globals.set:
            id: cerbo_online
            value: 'false'
        - logger.log: "Cerbo GX Modbus: offline"

  # Grid Smart Meter — Unit ID 31 (com.victronenergy.grid /0)
  - id: cerbo_grid
    modbustcp_id: cerbo_tcp
    address: 31
    update_interval: 2s

# ────────────── Global variables ──────────────
globals:
  - id: cerbo_online
    type: bool
    initial_value: 'false'
  - id: wattrouter_output
    type: float
    initial_value: '0.0'
  - id: thermostat_output
    type: float
    initial_value: '0.0'
  - id: pi_integral
    type: float
    initial_value: '0.0'

one_wire:
  - platform: gpio
    pin: GPIO15

