    name: "Cerbo GX online"
    id: cerbo_online_sensor
    device_class: connectivity
    lambda: |-
      return id(cerbo_online);
    icon: "mdi:lan-connect"
    web_server:
      sorting_group_id: group_status
      sorting_weight: 7

  - platform: template
    name: "Termostat aktivní"
    lambda: |-
      return id(thermostat_output) > 0.01f;
    icon: "mdi:clock-time-four"
