  - platform: template
    name: "Stykač L3"
    optimistic: true
    lambda: return id(stykac2).state;
    icon: "mdi:power-plug"
    web_server:
      sorting_group_id: group_status
      sorting_weight: 11

  - platform: gpio
    pin: GPIO13
    name: "Contactor L2"
    id: stykac1
    internal: true

  - platform: gpio
    pin: GPIO14
    name: "Contactor L3"
    id: stykac2
