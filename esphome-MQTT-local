# ────────────── TIME ──────────────
time:
  - platform: sntp
    id: sntp_time
    timezone: "Europe/Prague"

# ────────────── OUTPUT ──────────────
output:
  - platform: slow_pwm
    pin: GPIO12
    id: ssr
    period: 103ms
    zero_means_zero: true
    inverted: false

# ────────────── MAIN CONTROL LOOP ──────────────
interval:
  # Keepalive — publish every 30s or Cerbo stops sending MQTT data
  - interval: 30s
    then:
      - mqtt.publish:
          topic: "R/c0619ab36c7e/keepalive"
          payload: ""

  # Main regulation loop — every 2 seconds
  - interval: 2s
    then:
      - lambda: |-
          // ── Thermostat: P-controller with time windows ────────────────
          // Returns true if hh:mm falls within [sh:sm, eh:em)
          auto in_window = [](int h, int m, int sh, int sm, int eh, int em) -> bool {
            int now_min   = h * 60 + m;
            int start_min = sh * 60 + sm;
            int end_min   = eh * 60 + em;
            return (now_min >= start_min && now_min < end_min);
          };

          auto now = id(sntp_time).now();
          float therm_out = 0.0f;

          if (now.is_valid() && id(thermostat_enable).state) {
            int cur_h  = now.hour;
            int cur_m  = now.minute;
            // day_of_week: 1=Sunday, 2=Monday ... 7=Saturday
            bool is_weekend = (now.day_of_week == 1 || now.day_of_week == 7);
            bool is_workday = !is_weekend;
            float water_temp = id(temp).state;
            float p_gain  = id(thermostat_p_gain).state;
            float p_range = id(thermostat_p_range).state;

            // Find which window is active and get its target temperature
            float active_target = -1.0f;

            bool w1_ok = (is_workday && id(w1_workdays).state)
                      || (is_weekend && id(w1_weekend).state);
            if (w1_ok && in_window(cur_h, cur_m,
                   (int)id(w1_start_h).state, (int)id(w1_start_m).state,
                   (int)id(w1_end_h).state,   (int)id(w1_end_m).state))
              active_target = id(w1_temp).state;

            bool w2_ok = (is_workday && id(w2_workdays).state)
                      || (is_weekend && id(w2_weekend).state);
            if (w2_ok && in_window(cur_h, cur_m,
                   (int)id(w2_start_h).state, (int)id(w2_start_m).state,
                   (int)id(w2_end_h).state,   (int)id(w2_end_m).state))
              active_target = id(w2_temp).state;

            bool w3_ok = (is_workday && id(w3_workdays).state)
                      || (is_weekend && id(w3_weekend).state);
            if (w3_ok && in_window(cur_h, cur_m,
                   (int)id(w3_start_h).state, (int)id(w3_start_m).state,
                   (int)id(w3_end_h).state,   (int)id(w3_end_m).state))
              active_target = id(w3_temp).state;

            if (active_target > 0.0f) {
              // P-controller: error = how far below target we are
              // error > 0 → below target → heat
              // error <= 0 → at or above target → no heat
              float error = active_target - water_temp;
              if (error > 0.0f) {
                // Normalize by range, scale by gain, clamp to 0–1
                // At error=p_range → output=gain (clamped to 1.0)
                // At error=0       → output=0
                therm_out = std::min(1.0f, (error / p_range) * p_gain);
              }
              // error <= 0: temperature reached or exceeded target → output stays 0
            }
          }
          id(thermostat_output) = therm_out;

          // ── Wattrouter: P-controller ──────────────────────────────────
          // Only runs when enabled AND Cerbo is online
          if (id(wattrouter_enable).state && id(cerbo_online)) {
            float grid_w    = id(grid_power_total);
            float target_w  = id(wattrouter_target).state;
            float gain      = id(wattrouter_p_gain).state;
            float dead_band = id(wattrouter_dead_band).state;
            float max_w     = id(boiler_max_power).state;
            float cur_out   = id(total_power).state;

            // error < 0: exporting more than target → * -1 → positive delta → increase power
            // error > 0: exporting less than target → * -1 → negative delta → decrease power
            float error = grid_w - target_w;

            if (fabsf(error) > dead_band) {
              float delta = (error / max_w) * gain * -1.0f;
              float new_out = cur_out + delta;
              new_out = std::max(0.0f, std::min(1.0f, new_out));
              id(wattrouter_output) = new_out;
            }
            // Inside dead band → hold current output unchanged
          } else {
            id(wattrouter_output) = 0.0f;
          }

          // ── Combine: higher of wattrouter and thermostat wins ─────────
          // Wattrouter uses surplus solar → thermostat tops up from grid if needed
          float combined = std::max(id(wattrouter_output), id(thermostat_output));
          id(total_power).publish_state(combined);
