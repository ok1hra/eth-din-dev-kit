    id: w3_temp
    min_value: 20
    max_value: 95
    step: 0.5
    mode: box
    optimistic: true
    restore_value: true
    initial_value: 45.0
    unit_of_measurement: "°C"
    icon: "mdi:thermometer"
    web_server:
      sorting_group_id: group_window3
      sorting_weight: 6

  # Combined output 0.0–1.0
  - platform: template
    name: "Výkon (POWER OUT)"
    id: total_power
    min_value: 0.0
    max_value: 1.0
    step: 0.01
    mode: slider
    optimistic: true
    initial_value: 0.0
    icon: "mdi:lightning-bolt"
    web_server:
      sorting_group_id: group_status
      sorting_weight: 4
    on_value:
      - lambda: |-
          // Split 0–1 across three phases:
          // 0.00–0.33: SSR only on L1, contactors off
          // 0.33–0.67: contactor L2 on, SSR ramps on L1
          // 0.67–1.00: contactors L2+L3 on, SSR ramps on L1
          float per_phase = 1.0f / 3.0f;
          float v = x;
          float ssr_lvl = 0.0f;
          if (v < per_phase) {
            ssr_lvl = v / per_phase;
            id(stykac1).turn_off();
            id(stykac2).turn_off();
          } else if (v < 2.0f * per_phase) {
            ssr_lvl = (v - per_phase) / per_phase;
            id(stykac1).turn_on();
            id(stykac2).turn_off();
          } else {
            ssr_lvl = (v - 2.0f * per_phase) / per_phase;
            id(stykac1).turn_on();
            id(stykac2).turn_on();
          }
          id(ssr).set_level(ssr_lvl);

# ────────────── SENSORS ──────────────
sensor:
  - platform: dallas_temp
    address: 0x5a00001072aad528
    name: "Teplota vody"
    id: temp
    update_interval: 5s
    web_server:
      sorting_group_id: group_status
      sorting_weight: 1

  - platform: template
    name: "Výkon sítě celkem (W)"
    id: grid_power_sensor
    unit_of_measurement: "W"
    accuracy_decimals: 0
    update_interval: 2s
    lambda: |-
      return id(grid_power_total);
    icon: "mdi:transmission-tower"
    web_server:
      sorting_group_id: group_status
      sorting_weight: 2

  - platform: template
    name: "SOC baterie"
    id: soc_sensor
    unit_of_measurement: "%"
    accuracy_decimals: 0
    update_interval: 5s
    lambda: |-
      return id(soc_value_global);
    icon: "mdi:battery"
    web_server:
      sorting_group_id: group_status
      sorting_weight: 3

  # Thermostat P output — useful for monitoring how hard thermostat is working
  - platform: template
    name: "Termostat výkon (%)"
    id: thermostat_pct
    unit_of_measurement: "%"
    accuracy_decimals: 1
    update_interval: 2s
    lambda: |-
      return id(thermostat_output) * 100.0f;
    icon: "mdi:thermometer-auto"
    web_server:
      sorting_group_id: group_status
      sorting_weight: 5

  - platform: template
    name: "SSR úroveň"
    unit_of_measurement: ""
    update_interval: 1s
    lambda: |-
      return id(total_power).state;
    icon: "mdi:sine-wave"
    web_server:
      sorting_group_id: group_status
      sorting_weight: 6

