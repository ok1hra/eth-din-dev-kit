    min_value: 0.0
    max_value: 1.0
    step: 0.01
    mode: slider
    optimistic: true
    initial_value: 0.0
    icon: "mdi:lightning-bolt"
    web_server:
      sorting_group_id: group_status
      sorting_weight: 4
    on_value:
      - lambda: |-
          float per_phase = 1.0f / 3.0f;
          float v = x;
          float ssr_lvl = 0.0f;
          if (v < per_phase) {
            ssr_lvl = v / per_phase;
            id(stykac1).turn_off();
            id(stykac2).turn_off();
          } else if (v < 2.0f * per_phase) {
            ssr_lvl = (v - per_phase) / per_phase;
            id(stykac1).turn_on();
            id(stykac2).turn_off();
          } else {
            ssr_lvl = (v - 2.0f * per_phase) / per_phase;
            id(stykac1).turn_on();
            id(stykac2).turn_on();
          }
          id(ssr).set_level(ssr_lvl);

