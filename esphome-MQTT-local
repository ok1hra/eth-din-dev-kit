  # ── Thermostat P-controller ──

  # P gain for thermostat — scales how aggressively output responds to temperature error
  - platform: template
    name: "P zesílení (termostat)"
    id: thermostat_p_gain
    min_value: 0.1
    max_value: 5.0
    step: 0.1
    mode: box
    optimistic: true
    restore_value: true
    initial_value: 1.5
    icon: "mdi:tune-variant"
    web_server:
      sorting_group_id: group_thermostat
      sorting_weight: 0

  # Temperature range below target at which boiler runs at 100% power
  # e.g. range=10, target=60 → at 50°C power=100%, at 55°C power=50%, at 59°C power=10%
  - platform: template
    name: "Rozsah regulace (°C)"
    id: thermostat_p_range
    min_value: 1.0
    max_value: 30.0
    step: 0.5
    mode: box
    optimistic: true
    restore_value: true
    initial_value: 10.0
    unit_of_measurement: "°C"
    icon: "mdi:thermometer-lines"
    web_server:
      sorting_group_id: group_thermostat
      sorting_weight: 1

  # ── Time window 1 ──
  - platform: template
