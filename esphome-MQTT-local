# SOLARBEAM EMS NG - verze 9
# Změny: termostat zjednodušen — odstraněno P zesílení, zůstalo jen "Pásmo regulace (°C)"
#        výkon = clamp(error / pasmo, 0, 1) — gain pevně 1.0 v kódu

esphome:
  name: esphome-web-ab7e4c
  friendly_name: SOLARBEAM EMS NG - 1
  min_version: 2025.5.0
  name_add_mac_suffix: false
  on_boot:
    priority: -10
    then:
      - output.turn_on: ssr
      - output.set_level:
          id: ssr
          level: 0.0
      - switch.turn_off: wattrouter_enable
      - switch.turn_off: thermostat_enable

esp32:
  board: esp32dev
  framework:
    type: esp-idf

logger:
  level: INFO

api:

ota:
  - platform: esphome

web_server:
  port: 80
  version: 3
  sorting_groups:
    - id: group_status
      name: "📊 Status"
      sorting_weight: 1
    - id: group_wattrouter
      name: "⚡ Wattrouter"
      sorting_weight: 2
    - id: group_thermostat
      name: "🌡️ Termostat"
      sorting_weight: 3
    - id: group_window1
      name: "🕐 Časové okno 1"
      sorting_weight: 4
    - id: group_window2
      name: "🕑 Časové okno 2"
      sorting_weight: 5
    - id: group_window3
      name: "🕒 Časové okno 3"
      sorting_weight: 6

wifi:
  ssid: "Internet"
  password: "lopata#*"
  ap:
    ssid: "EMS NG"
    password: "12345678"

# ─── MQTT connection to Cerbo GX local broker ────────────────────
mqtt:
  broker: "192.168.27.37"
  port: 1883
  client_id: "solarbeam_ems"
  keepalive: 60s
  on_connect:
    then:
      - mqtt.publish:
          topic: "R/c0619ab36c7e/keepalive"
          payload: ""
      - logger.log: "Cerbo GX MQTT: connected, keepalive sent"
  on_disconnect:
    then:
      - logger.log: "Cerbo GX MQTT: disconnected"
  on_message:
    - topic: "N/c0619ab36c7e/system/0/Ac/Grid/L1/Power"
      then:
        - lambda: |-
            auto doc = json::parse_json(x);
            if (doc["value"].is<float>())
              id(grid_l1_power) = doc["value"].as<float>();
            else if (doc["value"].is<int>())
              id(grid_l1_power) = (float)doc["value"].as<int>();
            id(grid_power_total) = id(grid_l1_power) + id(grid_l2_power) + id(grid_l3_power);
            id(cerbo_online) = true;

    - topic: "N/c0619ab36c7e/system/0/Ac/Grid/L2/Power"
      then:
        - lambda: |-
            auto doc = json::parse_json(x);
            if (doc["value"].is<float>())
              id(grid_l2_power) = doc["value"].as<float>();
            else if (doc["value"].is<int>())
              id(grid_l2_power) = (float)doc["value"].as<int>();
            id(grid_power_total) = id(grid_l1_power) + id(grid_l2_power) + id(grid_l3_power);

    - topic: "N/c0619ab36c7e/system/0/Ac/Grid/L3/Power"
      then:
        - lambda: |-
            auto doc = json::parse_json(x);
            if (doc["value"].is<float>())
              id(grid_l3_power) = doc["value"].as<float>();
            else if (doc["value"].is<int>())
              id(grid_l3_power) = (float)doc["value"].as<int>();
            id(grid_power_total) = id(grid_l1_power) + id(grid_l2_power) + id(grid_l3_power);

    - topic: "N/c0619ab36c7e/system/0/Dc/Battery/Soc"
      then:
        - lambda: |-
            auto doc = json::parse_json(x);
            if (doc["value"].is<float>())
              id(soc_value_global) = doc["value"].as<float>();
            else if (doc["value"].is<int>())
              id(soc_value_global) = (float)doc["value"].as<int>();

# ────────────── Global variables ──────────────
globals:
  - id: grid_l1_power
    type: float
    initial_value: '0.0'
  - id: grid_l2_power
    type: float
    initial_value: '0.0'
  - id: grid_l3_power
    type: float
    initial_value: '0.0'
  - id: grid_power_total
    type: float
    initial_value: '0.0'
  - id: soc_value_global
    type: float
    initial_value: '0.0'
  - id: cerbo_online
    type: bool
    initial_value: 'false'
  - id: wattrouter_output
    type: float
    initial_value: '0.0'
  - id: thermostat_output
    type: float
    initial_value: '0.0'
  - id: pi_integral
    type: float
    initial_value: '0.0'

one_wire:
  - platform: gpio
    pin: GPIO15

