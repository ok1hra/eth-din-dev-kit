    max_value: 10.0
    step: 0.1
    mode: box
    optimistic: true
    restore_value: true
    initial_value: 1.0
    icon: "mdi:tune"
    web_server:
      sorting_group_id: group_wattrouter
      sorting_weight: 2

  - platform: template
    name: "Mrtvé pásmo (W)"
    id: wattrouter_dead_band
    min_value: 0
    max_value: 500
    step: 10
    mode: box
    optimistic: true
    restore_value: true
    initial_value: 100
    unit_of_measurement: "W"
    icon: "mdi:arrow-collapse-horizontal"
    web_server:
      sorting_group_id: group_wattrouter
      sorting_weight: 3

  - platform: template
    name: "Max. výkon bojleru (W)"
